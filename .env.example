# =============================================================================
# .env.example — ARQUIVO DE EXEMPLO
# =============================================================================
#
# INSTRUÇÕES:
#   1. Copie este arquivo e renomeie a cópia para: .env
#   2. Substitua os valores de exemplo pelos seus dados reais
#   3. NUNCA suba o arquivo .env para o GitHub (já está no .gitignore)
#
# Sprint 03: o chatbot roda 100% em cima do Ollama Cloud — nenhum modelo
# local, nenhuma API paga. Crie uma conta gratuita em https://ollama.com,
# gere uma API key e cole abaixo.
#
# =============================================================================

OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=COLE_AQUI_SUA_API_KEY

# Modelo padrão usado pelo core conversacional (Aula 01).
# Pode ser trocado sem alterar código — ver docs/relatorio_modelos.md.
OLLAMA_MODEL=gpt-oss:120b
